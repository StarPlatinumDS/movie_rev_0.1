<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit {{.Movie.Name}} - Movie Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .rating-preview {
            font-size: 1.5rem;
            color: #ffc107;
            margin: 10px 0;
        }
        .rating-input {
            display: none;
        }
        .rating-label {
            font-size: 1.5rem;
            color: #ddd;
            cursor: pointer;
            transition: color 0.2s;
        }
        .rating-label:hover,
        .rating-label:hover ~ .rating-label,
        .rating-input:checked ~ .rating-label {
            color: #ffc107;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <nav class="navbar navbar-expand-lg navbar-light bg-light rounded mb-4">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">
                    <i class="bi bi-film"></i> Movies
                </a>
                <div>
                    <a href="/movie/{{.Movie.ID}}" class="btn btn-outline-secondary btn-sm me-2">
                        <i class="bi bi-arrow-left"></i> Cancel
                    </a>
                    <button type="submit" form="editForm" class="btn btn-success btn-sm">
                        <i class="bi bi-check-lg"></i> Save Changes
                    </button>
                </div>
            </div>
        </nav>

        <div class="card">
            <div class="card-header">
                <h4>Edit Movie: {{.Movie.Name}}</h4>
            </div>
            <div class="card-body">
                <form id="editForm" method="POST" action="/movie/{{.Movie.ID}}/edit" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="name" class="form-label">Movie Name *</label>
                                <input type="text" class="form-control" id="name" name="name" value="{{.Movie.Name}}" required>
                            </div>
                            <div class="mb-3">
                                <label for="year" class="form-label">Year</label>
                                <input type="number" class="form-control" id="year" name="year" value="{{.Movie.Year}}" min="1800" max="2100">
                            </div>
                            <div class="mb-3">
                                <label for="genres" class="form-label">Genres *</label>
                                <select class="form-select" id="genres" name="genres" multiple required>
                                    {{range $.Genres}}
                                    <option value="{{.}}" {{if inSlice . $.Movie.Genres}}selected{{end}}>{{.}}</option>
                                    {{end}}
                                </select>
                                <small class="text-muted">Hold Ctrl/Cmd to select multiple</small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Your Rating *</label>
                                <div class="rating-preview" id="ratingPreview">
                                    {{range $i := iterate 5}}
                                        {{if lt $i $.Movie.Rating}}
                                            <i class="bi bi-star-fill"></i>
                                        {{else}}
                                            <i class="bi bi-star"></i>
                                        {{end}}
                                    {{end}}
                                    <span class="ms-2" id="ratingValue">{{.Movie.Rating}}/5</span>
                                </div>
                                <div>
                                    {{range $i, $e := iterate 5}}
                                    <input type="radio" class="rating-input" name="rating" id="star{{$i}}" value="{{$i}}" {{if eq $.Movie.Rating $i}}checked{{end}}>
                                    <label for="star{{$i}}" class="rating-label" onclick="setRating({{$i}})">
                                        <i class="bi bi-star-fill"></i>
                                    </label>
                                    {{end}}
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="world_rating" class="form-label">World Rating (0.0 - 10.0)</label>
                                <input type="number" class="form-control" id="world_rating" name="world_rating" 
                                       value="{{printf "%.1f" .Movie.WorldRating}}" step="0.1" min="0" max="10">
                            </div>
                            <div class="mb-3">
                                <label for="picture" class="form-label">New Poster (optional)</label>
                                <input type="file" class="form-control" id="picture" name="picture" accept="image/*">
                                <small class="text-muted">Leave empty to keep current poster</small>
                            </div>
                            <div class="mb-3">
                                <label for="description" class="form-label">Description</label>
                                <textarea class="form-control" id="description" name="description" rows="3">{{.Movie.Description}}</textarea>
                            </div>
                            <div class="mb-3">
                                <label for="comment" class="form-label">Comment (max 250 chars)</label>
                                <textarea class="form-control" id="comment" name="comment" rows="2" maxlength="250">{{.Movie.Comment}}</textarea>
                                <small class="text-muted">Characters left: <span id="charCount">250</span></small>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Update character counter
        document.getElementById('comment').addEventListener('input', function() {
            document.getElementById('charCount').textContent = 250 - this.value.length;
        });

        // Update rating display
        function setRating(value) {
            document.querySelectorAll('.rating-input').forEach((input, i) => {
                if (i === value) {
                    input.checked = true;
                    updateRatingPreview(value);
                }
            });
        }

        function updateRatingPreview(value) {
            const preview = document.getElementById('ratingPreview');
            let stars = '';
            for (let i = 0; i < 5; i++) {
                stars += i < value ? '<i class="bi bi-star-fill"></i>' : '<i class="bi bi-star"></i>';
            }
            preview.innerHTML = stars + '<span class="ms-2" id="ratingValue">' + value + '/5</span>';
        }

        // Helper for template
        function iterate(n) {
            return Array.from({length: n}, (_, i) => i);
        }
    </script>
</body>
</html>