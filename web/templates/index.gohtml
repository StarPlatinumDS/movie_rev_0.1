<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movies</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h1 class="mb-4">🎬 Movies</h1>

        <!-- Форма загрузки -->
        <div class="card mb-4">
            <div class="card-header">
                <h5>Add New Movie</h5>
            </div>
            <div class="card-body">
                <form method="POST" action="/movies" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="name" class="form-label">Movie Name</label>
                        <input type="text" class="form-control" id="name" name="name" required>
                    </div>
                    <div class="mb-3">
                        <label for="picture" class="form-label">Picture</label>
                        <input type="file" class="form-control" id="picture" name="picture" accept="image/*" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Add Movie</button>
                </form>
            </div>
        </div>

        <!-- Список фильмов -->
        <div class="row">
            {{range .}}
            <div class="col-md-4 mb-4">
                <div class="card">
                    <img src="{{.PictureURL}}" class="card-img-top" alt="{{.Name}}" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title">{{.Name}}</h5>
                        <a href="/movies/delete?id={{.ID}}" class="btn btn-danger btn-sm" onclick="return confirm('Delete this movie?')">Delete</a>
                    </div>
                </div>
            </div>
            {{end}}
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>