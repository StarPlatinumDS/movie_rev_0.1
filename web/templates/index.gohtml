<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movies</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .card-img-top {
            height: 200px;
            object-fit: cover;
        }
        .movie-link {
            text-decoration: none;
            color: inherit;
        }
        .movie-link:hover {
            text-decoration: none;
            color: inherit;
        }
        .comment-indicator {
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: 1.2rem;
            color: #ffc107;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">🎬 Movies</a>
            <div class="d-flex">
                <a href="/search" class="btn btn-outline-light me-2">Поиск</a>
                <a href="/" class="btn btn-outline-light">Главная</a>
            </div>
        </div>
    </nav>
    <div class="container mt-5">
        <h1 class="mb-4">🎬 Movies</h1>

        <!-- Форма загрузки -->
        <div class="card mb-4">
            <div class="card-header">
                <h5>Add New Movie</h5>
            </div>
            <div class="card-body">
                <form method="POST" action="/movies" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="name" class="form-label">Movie Name *</label>
                                <input type="text" class="form-control" id="name" name="name" required>
                            </div>
                            <div class="mb-3">
                                <label for="year" class="form-label">Year</label>
                                <input type="number" class="form-control" id="year" name="year" min="1800" max="2100">
                            </div>
                            <div class="mb-3">
                                <label for="genres" class="form-label">Genres *</label>
                                <select class="form-select" id="genres" name="genres" multiple required>
                                    {{range $.Genres}}
                                    <option value="{{.}}">{{.}}</option>
                                    {{end}}
                                </select>
                                <small class="text-muted">Hold Ctrl/Cmd to select multiple</small>
                            </div>
                            <div class="mb-3">
                                <label for="rating" class="form-label">Your Rating *</label>
                                <select class="form-select" id="rating" name="rating" required>
                                    <option value="1">★☆☆☆☆ (1)</option>
                                    <option value="2">★★☆☆☆ (2)</option>
                                    <option value="3">★★★☆☆ (3)</option>
                                    <option value="4">★★★★☆ (4)</option>
                                    <option value="5" selected>★★★★★ (5)</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="world_rating" class="form-label">World Rating (0.0 - 10.0)</label>
                                <input type="number" class="form-control" id="world_rating" name="world_rating" step="0.1" min="0" max="10" placeholder="e.g., 7.5">
                            </div>
                            <div class="mb-3">
                                <label for="picture" class="form-label">Poster *</label>
                                <input type="file" class="form-control" id="picture" name="picture" accept="image/*" required>
                            </div>
                            <div class="mb-3">
                                <label for="description" class="form-label">Description</label>
                                <textarea class="form-control" id="description" name="description" rows="3"></textarea>
                            </div>
                            <div class="mb-3">
                                <label for="comment" class="form-label">Comment (max 250 chars)</label>
                                <textarea class="form-control" id="comment" name="comment" rows="2" maxlength="250"></textarea>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Add Movie</button>
                </form>
            </div>
        </div>

        <!-- Список фильмов -->
        <h2 class="mb-3">Your Collection</h2>
        <div class="row">
            {{range .Movies}}
            <div class="col-md-4 mb-4">
                <a href="/movie/{{.ID}}" class="movie-link">
                    <div class="card h-100 shadow-sm">
                        <div class="position-relative">
                            <img src="{{.PictureURL}}" class="card-img-top" alt="{{.Name}}">
                            {{if .HasComment}}
                            <span class="comment-indicator" title="Has comment">
                                <i class="bi bi-chat-fill"></i>
                            </span>
                            {{end}}
                        </div>
                        <div class="card-body">
                            <h5 class="card-title mb-2">{{.Name}}</h5>
                            {{if gt (len .Genres) 0}}
                            <p class="card-text small text-muted">
                                {{range $index, $genre := .Genres}}
                                    {{$genre}}{{if lt $index (sub (len $.Genres) 1)}}, {{end}}
                                {{end}}
                            </p>
                            {{end}}
                            {{if .Year}}
                            <p class="card-text small">
                                <i class="bi bi-calendar"></i> {{.Year}}
                            </p>
                            {{end}}
                            {{if .WorldRating}}
                            <p class="card-text small">
                                <i class="bi bi-star-fill text-warning"></i> {{printf "%.1f" .WorldRating}}/10
                            </p>
                            {{end}}
                            <a href="/movies/delete?id={{.ID}}" class="btn btn-danger btn-sm" onclick="return confirm('Delete this movie?')">Delete</a>
                        </div>
                    </div>
                </a>
            </div>
            {{end}}
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>